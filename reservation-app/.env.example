# Supabaseプロジェクトの Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。絶対にNEXT_PUBLIC_を付けない・クライアントに露出させない
SUPABASE_SERVICE_ROLE_KEY=

# メール送信 (Resend: https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="サンプルサロン <no-reply@example.com>"

# このアプリ自体のURL(メール内リンク生成に使用)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MVPでは1サロン・1スタッフのみのため、supabase/seed.sqlのIDと合わせて指定
DEFAULT_SALON_ID=00000000-0000-0000-0000-000000000001
NEXT_PUBLIC_DEFAULT_SALON_ID=00000000-0000-0000-0000-000000000001

# WordPressサイトからiframeで埋め込む場合、そのオリジンを指定(例: https://your-salon.com)
# 未設定の場合は全オリジンからの埋め込みを許可(開発用)
WORDPRESS_SITE_ORIGIN=*
