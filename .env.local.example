# Supabaseプロジェクトの設定 > API から取得してください
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 管理画面ログイン用パスワード(任意の文字列を設定してください)
ADMIN_PASSWORD=

# Claude API(console.anthropic.comで発行)
ANTHROPIC_API_KEY=
# 省略可。既定はコストの低いclaude-haiku-4-5
CLAUDE_MODEL=

# WordPress REST API(アプリケーションパスワード認証)
WORDPRESS_URL=https://your-site.example.com
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
# 省略可。既定はdraft(下書き)。確認なしで即公開したい場合のみ publish に変更
WORDPRESS_POST_STATUS=draft

# Google Business Profile連携(Google Cloud ConsoleでOAuthクライアントを作成して取得)
# 承認済みリダイレクトURIに http://localhost:3000/api/google/callback と
# 本番URL/api/google/callback の両方を登録してください
# ※ Business Profile APIの投稿・口コミ機能はGoogleへの別途アクセス申請が必要です
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
